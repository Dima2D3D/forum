DirectoryIndex index.php
Options -Indexes -MultiViews
RewriteEngine On

# Канонические URL без .php в адресной строке.
# Если пользователь открыл /thread.php?id=123 напрямую, отправляем его на /thread?id=123.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Разрешаем обращаться к PHP-файлам без расширения.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Красивые профили: /Dima2D3D вместо /profile.php?id=1.
# Существующие файлы и папки не перехватываем.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_]{3,24})/?$ profile.php?handle=$1 [L,QSA]
