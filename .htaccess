DirectoryIndex index.php
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(json|log)$">
        Require all denied
    </FilesMatch>
    <Files "config.php">
        Require all denied
    </Files>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(json|log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "config.php">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>
